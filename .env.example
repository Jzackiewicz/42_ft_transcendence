# --- Database Configuration ---
USE_POSTGRES=1
POSTGRES_DB=quizdb
POSTGRES_USER=quizuser
POSTGRES_PASSWORD=example_db_password
DB_NAME=quizdb
DB_USER=quizuser
DB_PASSWORD=example_db_password
DB_HOST=db
# Internal Redis/DB service ports used by the app/container network.
# Do not change these to avoid host port collisions; use EXPOSED_PORT instead.
DB_PORT=5432
REDIS_PORT=6379

# Host port mappings (change these if you have port collisions on your machine)
# standard: POSTGRES 5432, REDIS 6379, HTTP 80, HTTPS 443
DB_EXPOSED_PORT=5432
REDIS_EXPOSED_PORT=6380
BACKEND_EXPOSED_PORT=8000
HTTP_EXPOSED_PORT=8080
HTTPS_EXPOSED_PORT=8443

# Dev-specific host port mappings (to avoid conflict with production stack)
DEV_DB_EXPOSED_PORT=5433
DEV_REDIS_EXPOSED_PORT=6381
DEV_BACKEND_EXPOSED_PORT=8001
DEV_HTTP_EXPOSED_PORT=8081
DEV_HTTPS_EXPOSED_PORT=8444

# --- Django Configuration ---
#DEBUG=True
DEBUG=False
SECRET_KEY=example_django_secret_key
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
ALLOWED_HOSTS=localhost,127.0.0.1,localhost:${HTTPS_EXPOSED_PORT},127.0.0.1:${HTTPS_EXPOSED_PORT}
CSRF_TRUSTED_ORIGINS=https://localhost:${HTTPS_EXPOSED_PORT},https://127.0.0.1:${HTTPS_EXPOSED_PORT},http://localhost:5173,http://127.0.0.1:5173
REDIS_HOST=redis

# --- Game Settings ---
QUESTIONS_PER_SESSION=10
DISCONNECT_GRACE_PERIOD_S=30
ANSWER_TIME_LIMIT_MS=20000
EVALUATION_TIME_LIMIT_MS=3000
NOMINATION_TIME_LIMIT_MS=10000

# --- AI Configuration ---
LLM_API_KEY=sk-example-llm-api-key
LLM_MODEL=gemini-3.1-flash-lite

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://localhost:8443/api/account/oauth/google/callback/
