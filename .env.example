# --- Database Configuration ---
USE_POSTGRES=1
POSTGRES_DB=quizdb
POSTGRES_USER=quizuser
POSTGRES_PASSWORD=example_db_password
DB_NAME=quizdb
DB_USER=quizuser
DB_PASSWORD=example_db_password
DB_HOST=db
# Internal Redis/DB service ports used by the app/container network.
# Do not change these to avoid host port collisions; use EXPOSED_PORT instead.
DB_PORT=5432
REDIS_PORT=6379

# Host port mappings (change these if you have port collisions on your machine)
DB_EXPOSED_PORT=5432
REDIS_EXPOSED_PORT=6379

# --- Django Configuration ---
DEBUG=True
SECRET_KEY=example_django_secret_key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
REDIS_HOST=redis

# --- AI Configuration ---
LLM_API_KEY=sk-example-llm-api-key
