# 1. Automatic line endings management (LF) across different platforms
* text=auto

# Source code and script files - enforce Unix line endings (LF)
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.template text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.env text eol=lf
.env.example text eol=lf

# 2. Binary files - prevent any conversion and avoid file corruption
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary

# 3. Hide autogenerated package lockfiles in PR diffs (GitHub/GitLab)
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
**/package-lock.json linguist-generated=true
**/yarn.lock linguist-generated=true
**/pnpm-lock.yaml linguist-generated=true

# 4. Hide compiled assets / source maps
*.map linguist-generated=true
*.min.js linguist-generated=true
*.min.css linguist-generated=true

# 5. Hide complex SVG vector graphic diffs (treat as generated files)
*.svg linguist-generated=true
