@startuml Quizscendence_DevOps
title Quizscendence — Container View

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 12
skinparam ranksep 45
skinparam defaultTextAlignment center

' ---- Shared palette (matches logical_view) ----
skinparam database {
  BackgroundColor #FADBD8
  BorderColor #C0392B
}
skinparam cloud {
  BackgroundColor #FADBD8
  BorderColor #C0392B
}

actor Browser as user

node "Docker Compose" #E4E7EC {
  node "proxy\n(Nginx)" as nginx #FCE4D6 {
    note right of nginx
      SSL termination
      HTTP→HTTPS redirect
      :8080 / :8443
    end note
  }

  node "web" as web #EAF4FF {
    component "React 19 SPA" as spa
  }

  node "api\n(Daphne / ASGI)" as api #E5D9F2 {
    component "DRF\n(HTTP APIs)" as drf
    component "Channels\n(WebSocket consumers)" as channels
    component "In-process state\n(GameTimerManager,\nPresenceRegistry)" as inproc
  }

  node "db" as dbnode #FADBD8 {
    database "PostgreSQL 15" as pg
  }

  node "redis" as redisnode #FADBD8 {
    database "Redis 7" as redis
  }
}

cloud "Google" {
  component "OAuth 2.0" as goauth
  component "Gemini LLM" as gemini
}

user --> nginx : HTTPS / WSS
nginx --> web : static assets
nginx --> api : /api/*  +  /ws/*

drf --> pg : ORM
channels --> pg : ORM
drf ..> redis : cache (AI rate-limit)
channels --> redis : CHANNEL_LAYERS

drf --> goauth : OAuth login/callback
drf --> gemini : question generation

@enduml
