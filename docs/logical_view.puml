@startuml Quizscendence_Logical
title Logical Architecture (Service-Layer Pattern)

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 12
skinparam ranksep 45
skinparam defaultTextAlignment center

' ---- Highlight styles (by role) ----
skinparam component {
  BackgroundColor<<core>> #FFE9A8
  BorderColor<<core>> #B8860B
  BackgroundColor<<realtime>> #CFF3D6
  BorderColor<<realtime>> #1E7D43
}
skinparam database {
  BackgroundColor #FADBD8
  BorderColor #C0392B
}
skinparam cloud {
  BackgroundColor #FADBD8
  BorderColor #C0392B
}

package "Frontend (React SPA)" #EAF4FF {
  [Pages\nAuth / Home / Game] as pages
  [Contexts\nUser / Presence / Friends] as ctx
  [API wrappers (axios)] as axios
  [WebSocket hooks\nuseGamePage / Presence] as wshooks
}

package "Backend (Django)" #E4E7EC {

  package "account" #FCE4D6 {
    [apis.py] as acc_api
    [<b>Services</b>\noauth_google / profiles] as acc_svc
    [EmailOrUsernameBackend] as acc_auth
    [PresenceRegistry] as presence
    [<b>Models</b>\nUserProfile / SocialAccount] as acc_models
  }

  package "social" #D7F0DC {
    [apis.py\nfriends / history] as soc_api
    [ChatConsumer] as soc_ws <<realtime>>
    [<b>Services</b>\n(friendships · guards)] as soc_svc
    [<b>Models</b>\nChatMessage / Friendship /\nFriendRequest] as soc_models
  }

  package "game" #E5D9F2 {
    [GameConsumer] as g_ws <<realtime>>
    [apis.py\nlobby / stats / gen] as g_api
    [lobby_management\ncreate / join / destroy] as g_lobby
    [<b>GameActionHandler</b>] as g_handler <<core>>
    [<b>GameService</b>\nguards · scoring · lifecycle] as g_service <<core>>
    [<b>fsm.py</b>\n(GameStateMachine)] as g_fsm <<core>>
    [GameTimerManager] as g_timer
    [question_generation\n(Gemini)] as g_ai
    [<b>Models</b>\nGameSession / SessionPlayer /\nQuestion / SessionQuestion /\nAnswerAttempt] as g_models
  }
}

database "PostgreSQL" as pg
database "Redis\n(channel layer + cache)" as redis
cloud "Gemini LLM" as gemini
cloud "Google OAuth" as google

' keep the frontend centered above the backend (invisible anchor)
pages -[hidden]down-> g_api

' ---- Frontend wiring ----
pages --> ctx
pages --> axios
pages --> wshooks
axios --> acc_api : REST
axios --> g_api : REST
axios --> soc_api : REST
wshooks --> g_ws : WSS /ws/game
ctx --> soc_ws : WSS /ws/chat (+presence)

' ---- Game backend flow ----
g_ws --> g_handler : validated action
g_api --> g_lobby : REST lobby ops
g_api --> g_ai
g_lobby --> g_models
g_lobby --> redis : group_send (extra questions)
g_handler --> g_service
g_service --> g_fsm : transitions
g_service --> g_models
g_handler --> g_timer : schedule next deadline
g_timer ..> g_handler : timeout fires action

' ---- Account / social ----
acc_api --> acc_svc
acc_api --> acc_auth
acc_svc --> google : OAuth2 token / id_token verify
acc_svc --> acc_models
acc_auth --> acc_models
soc_ws --> presence
soc_ws --> soc_svc
soc_svc --> soc_models

' ---- Persistence & infra ----
acc_models --> pg
soc_models --> pg
g_models --> pg
g_ws --> redis : group_send
soc_ws --> redis : group_send
g_api ..> redis : AI rate-limit cache
g_ai --> gemini

@enduml
